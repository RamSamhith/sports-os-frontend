# ─── Frontend (Next.js) ────────────────────────────────────────
# Public
NEXT_PUBLIC_SITE_URL=https://sportsos.example.com
NEXT_PUBLIC_SITE_NAME=SportsOS

# API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Analytics (consent-gated)
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# PostHog analytics (consent-gated)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Feature flags
NEXT_PUBLIC_ENABLE_ADMIN=false
NEXT_PUBLIC_ENABLE_AI=false

# OAuth (Social Login)
# Google: Create at https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Microsoft: Create at https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=

# Cloudinary (Image CDN)
# Create at https://cloudinary.com — free tier supports 25k transformations/mo
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ─── Backend (Node.js / Express) ──────────────────────────────
# MongoDB connection string (required)
MONGO_URI=mongodb://localhost:27017/sportsos

# JWT secret — used to sign access tokens (required, min 32 chars)
JWT_SECRET=change-me-to-a-random-string-at-least-32-characters

# JWT refresh secret — used to sign refresh tokens (required, min 32 chars)
JWT_REFRESH_SECRET=change-me-to-another-random-string-at-least-32-characters

# JWT expiry — access token lifetime (default: 15m)
JWT_ACCESS_EXPIRY=15m

# Refresh token lifetime (default: 30d)
JWT_REFRESH_EXPIRY=30d

# CORS — comma-separated list of allowed origins
# Leave empty to allow all origins (development only)
ALLOWED_ORIGINS=https://sportsos-ui.vercel.app,https://sportsos.vercel.app,https://www.sportsos.in

# Server port (default: 3000)
PORT=3000

# ─── Email (Resend) ──────────────────────────────────────────
# Resend API key (required for email delivery)
RESEND_API_KEY=

# Sender email (must be from verified domain in Resend)
EMAIL_FROM=noreply@sportsos.com

# Frontend URL for password reset links
FRONTEND_URL=https://sportsos.vercel.app

# ─── Monitoring (Sentry) ──────────────────────────────────────
# Sentry DSN for backend error tracking
SENTRY_DSN=

# Sentry DSN for frontend error tracking (public)
NEXT_PUBLIC_SENTRY_DSN=

# App version for Sentry release tracking
APP_VERSION=0.1.0
